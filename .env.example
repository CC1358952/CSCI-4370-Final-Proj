# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. Never commit real keys.
# Use plain KEY=value lines with no quotes.

# Resend (https://resend.com) sends the password reset emails.
# Create a key at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=

# Sender address. onboarding@resend.dev works for testing but only delivers
# to the email you signed up to Resend with. Verify a domain to send to anyone.
RESEND_FROM=Sleigh List <onboarding@resend.dev>

# Base URL used to build the reset link inside the email.
APP_BASE_URL=http://localhost:8081
