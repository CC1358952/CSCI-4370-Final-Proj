{{> partials/top}}
{{> partials/nav}}
<nav class="crumbs" aria-label="Breadcrumb">
    <a href="/groups">Groups</a> <span aria-hidden="true">/</span>
    <a href="/groups/{{group.id}}">{{group.name}}</a> <span aria-hidden="true">/</span>
    Secret Santa
</nav>
<div class="page-head">
    <div>
        <h1>Secret Santa</h1>
        <p class="lede">{{group.name}}. Spending limit {{group.santaLimitLabel}}, gifts exchanged {{group.exchangeLabel}}.</p>
    </div>
</div>

{{#drawn}}
<div class="layout-aside">
    <section class="reveal" data-reveal>
        <p class="reveal-kicker">Your Secret Santa match</p>
        <button class="reveal-cover" type="button" data-reveal-btn aria-expanded="false" aria-controls="reveal-body">
            Tap to see who you drew
        </button>
        <div class="reveal-body" id="reveal-body" hidden>
            {{#recipient}}
            <span class="avatar avatar-xl" style="--c:{{color}}" aria-hidden="true">{{initials}}</span>
            <p class="reveal-name">{{name}}</p>
            <p>Keep it to yourself. Only you can see this.</p>
            <a class="btn" href="/groups/{{group.id}}/members/{{id}}">Open {{firstName}}'s list</a>
            {{/recipient}}
        </div>
    </section>
    {{#group.youAreAdmin}}
    <aside class="panel stack">
        <h2 class="panel-title">Organizer</h2>
        <p class="small">Names were drawn for all {{group.memberCount}} members. Each person can only see their own match.</p>
        <form method="post" action="/groups/{{group.id}}/santa/reset">
            <button class="btn btn-danger-quiet btn-small" type="submit">Redo the draw</button>
        </form>
        <p class="small muted">Redoing clears everyone's match and lets you edit exclusions.</p>
    </aside>
    {{/group.youAreAdmin}}
</div>
{{/drawn}}

{{^drawn}}
{{#group.youAreAdmin}}
<div class="layout-split">
    <section class="panel" aria-labelledby="who-h">
        <h2 class="panel-title" id="who-h">Who can draw whom</h2>
        <p class="small muted">Everyone draws someone in the group other than themselves and anyone they're excluded from.</p>
        <ul class="eligible">
            {{#eligibility}}
            <li>
                {{#member}}<span class="who"><span class="avatar avatar-sm" style="--c:{{color}}" aria-hidden="true">{{initials}}</span>{{name}}</span>{{/member}}
                <span class="eligible-count">{{count}} options</span>
                <span class="small muted eligible-names">{{names}}</span>
            </li>
            {{/eligibility}}
        </ul>
    </section>

    <div class="stack">
        <section class="panel stack" aria-labelledby="ex-h">
            <h2 class="panel-title" id="ex-h">Exclusions</h2>
            <ul class="plain-list">
                {{#exclusions}}
                <li>
                    <span>{{a.firstName}} and {{b.firstName}} <span class="muted small">{{reason}}</span></span>
                    <form method="post" action="/groups/{{group.id}}/santa/exclusions/{{id}}/delete">
                        <button class="btn btn-link btn-small" type="submit">Remove<span class="sr-only"> exclusion for {{a.firstName}} and {{b.firstName}}</span></button>
                    </form>
                </li>
                {{/exclusions}}
                {{^exclusions}}<li class="muted">No exclusions yet.</li>{{/exclusions}}
            </ul>
            <form class="stack" method="post" action="/groups/{{group.id}}/santa/exclusions">
                <div class="field-row">
                    <div class="field">
                        <label for="ex-a">Person</label>
                        <select id="ex-a" name="memberA"><option value="" selected disabled>Choose</option>{{#members}}<option value="{{id}}">{{name}}</option>{{/members}}</select>
                    </div>
                    <div class="field">
                        <label for="ex-b">Can't draw</label>
                        <select id="ex-b" name="memberB"><option value="" selected disabled>Choose</option>{{#members}}<option value="{{id}}">{{name}}</option>{{/members}}</select>
                    </div>
                </div>
                <div class="field">
                    <label for="ex-reason">Reason (optional)</label>
                    <input id="ex-reason" name="reason" placeholder="Couple">
                </div>
                <button class="btn btn-quiet btn-small" type="submit">Add exclusion</button>
            </form>
        </section>

        <form class="panel draw" method="post" action="/groups/{{group.id}}/santa/draw">
            <p>Ready? Everyone gets one name, and nobody draws themselves or someone they're excluded from.</p>
            <button class="btn btn-gold" type="submit">Draw names</button>
        </form>
    </div>
</div>
{{/group.youAreAdmin}}
{{^group.youAreAdmin}}
<div class="empty">
    <h2>Names haven't been drawn yet</h2>
    <p>The group organizer will run the draw. You'll see your match here.</p>
</div>
{{/group.youAreAdmin}}
{{/drawn}}
{{> partials/bottom}}
