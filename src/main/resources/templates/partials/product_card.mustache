<article class="product">
    {{#imageUrl}}<img class="thumb thumb-img" src="{{imageUrl}}" alt="" loading="lazy">{{/imageUrl}}
    {{^imageUrl}}<div class="thumb" style="--h:{{hue}}" aria-hidden="true">{{initial}}</div>{{/imageUrl}}
    <div class="product-body">
        <p class="product-cat">{{category}}</p>
        <h3 class="product-title"><a href="{{link}}" target="_blank" rel="noopener">{{title}}<span class="sr-only"> (opens in a new tab)</span></a></h3>
        <p class="product-rating">
            <span class="stars" style="--pct:{{starsPct}}%" role="img" aria-label="{{starsLabel}} out of 5 stars"></span>
            <span>{{starsLabel}}</span>
            <span class="muted">({{reviewsLabel}})</span>
        </p>
        <p class="product-price">
            <strong>{{priceLabel}}</strong>
            {{#onSale}}<s class="muted">{{listPriceLabel}}</s>{{/onSale}}
            {{#bestseller}}<span class="chip chip-gold">Bestseller</span>{{/bestseller}}
        </p>
    </div>
    <form class="product-add" method="post" action="/lists/items">
        <input type="hidden" name="productId" value="{{id}}">
        <label class="sr-only" for="list-{{id}}">Wish list</label>
        <select id="list-{{id}}" name="listId">
            {{#myLists}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/myLists}}
        </select>
        <button class="btn btn-small" type="submit">Add to list</button>
    </form>
</article>
