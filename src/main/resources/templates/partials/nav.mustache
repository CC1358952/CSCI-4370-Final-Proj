<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
    <div class="shell topbar-inner">
        <a class="brand" href="/groups" aria-label="Sleigh List home">
            <svg class="brand-tag" viewBox="0 0 32 20" aria-hidden="true"><path d="M8 0h22a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8L0 10z" fill="currentColor"/><circle cx="8.5" cy="10" r="2.2" fill="var(--paper)"/></svg>
            <span>Sleigh List</span>
        </a>
        <nav class="mainnav" aria-label="Main">
            <a href="/groups" {{#navGroups}}aria-current="page"{{/navGroups}}>Groups</a>
            <a href="/lists" {{#navLists}}aria-current="page"{{/navLists}}>My lists</a>
            <a href="/products" {{#navProducts}}aria-current="page"{{/navProducts}}>Browse</a>
            <a href="/finder" {{#navFinder}}aria-current="page"{{/navFinder}}>Gift finder</a>
            <a href="/budget" {{#navBudget}}aria-current="page"{{/navBudget}}>Budget</a>
        </nav>
        <div class="usermenu">
            {{#me}}<span class="avatar" style="--c:{{color}}" aria-hidden="true">{{initials}}</span><span class="usermenu-name">{{firstName}}</span>{{/me}}
            <a class="usermenu-out" href="/logout">Log out</a>
        </div>
    </div>
</header>
<main id="main" class="shell page">
