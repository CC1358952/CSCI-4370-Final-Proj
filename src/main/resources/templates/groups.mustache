{{> partials/top}}
{{> partials/nav}}
<div class="page-head">
    <div>
        <h1>Your groups</h1>
        <p class="lede">Each group shares wish lists, claims and its own Secret Santa.</p>
    </div>
</div>

<div class="layout-aside">
    <section aria-label="Groups" class="group-list">
        {{#groups}}
        <article class="panel group-card">
            <div class="group-card-main">
                <h2><a href="/groups/{{id}}">{{name}}</a></h2>
                <p class="muted">{{occasion}} exchange on {{exchangeLabel}}, {{daysLeft}} days away</p>
                <div class="avatars" aria-label="{{memberCount}} members">
                    {{#avatarMembers}}<span class="avatar" style="--c:{{color}}" title="{{name}}">{{initials}}</span>{{/avatarMembers}}
                    {{#extraMembers}}<span class="avatar avatar-more">+{{extraMembers}}</span>{{/extraMembers}}
                </div>
            </div>
            <div class="group-card-side">
                {{#youAreAdmin}}<span class="chip">You run this group</span>{{/youAreAdmin}}
                {{#santaDrawn}}<span class="chip chip-gold">Names drawn</span>{{/santaDrawn}}
                <div class="btn-row">
                    <a class="btn btn-quiet btn-small" href="/groups/{{id}}">Dashboard</a>
                    <a class="btn btn-quiet btn-small" href="/groups/{{id}}/santa">Secret Santa</a>
                </div>
            </div>
        </article>
        {{/groups}}
        {{^groups}}
        <div class="empty">
            <h2>You're not in any groups yet</h2>
            <p>Start one for your family or roommates, or ask someone for their invite code.</p>
        </div>
        {{/groups}}
    </section>

    <aside class="stack">
        <form class="panel stack" method="post" action="/groups">
            <h2 class="panel-title">Start a group</h2>
            <div class="field">
                <label for="g-name">Group name</label>
                <input id="g-name" name="name" placeholder="Park Family Christmas" required>
            </div>
            <div class="field">
                <label for="g-occasion">Occasion</label>
                <input id="g-occasion" name="occasion" placeholder="Christmas">
            </div>
            <div class="field">
                <label for="g-date">Exchange date</label>
                <input id="g-date" name="exchangeDate" type="date">
            </div>
            <button class="btn" type="submit">Create group</button>
        </form>
        <form class="panel stack" method="post" action="/groups/join">
            <h2 class="panel-title">Join with a code</h2>
            <div class="field">
                <label for="code">Invite code</label>
                <input id="code" name="inviteCode" placeholder="PARK-7Q2X" autocomplete="off" required>
            </div>
            <button class="btn btn-quiet" type="submit">Join group</button>
        </form>
    </aside>
</div>
{{> partials/bottom}}
