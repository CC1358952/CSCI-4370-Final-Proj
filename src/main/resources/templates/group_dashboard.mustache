{{> partials/top}}
{{> partials/nav}}
{{#group}}
<nav class="crumbs" aria-label="Breadcrumb"><a href="/groups">Groups</a> <span aria-hidden="true">/</span> {{name}}</nav>
<div class="page-head">
    <div>
        <h1>{{name}}</h1>
        <p class="lede">{{occasion}} exchange on {{exchangeLabel}}. {{daysLeft}} days to go.</p>
    </div>
    <div class="btn-row">
        <span class="invite">Invite code <code>{{inviteCode}}</code></span>
        <a class="btn" href="/groups/{{id}}/santa">Secret Santa</a>
    </div>
</div>
{{/group}}

<dl class="facts panel">
    {{#facts}}
    <div class="fact"><dt>{{label}}</dt><dd>{{value}}</dd></div>
    {{/facts}}
</dl>

<div class="layout-split">
    <section class="panel" aria-labelledby="members-h">
        <h2 class="panel-title" id="members-h">Members and their lists</h2>
        <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th scope="col">Member</th><th scope="col" class="num">Items</th><th scope="col" class="num">Unclaimed</th><th scope="col" class="num">List value</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
                {{#stats}}
                <tr>
                    <th scope="row">{{#member}}<span class="who"><span class="avatar avatar-sm" style="--c:{{color}}" aria-hidden="true">{{initials}}</span>{{name}}</span>{{/member}}{{#you}} <span class="muted">(you)</span>{{/you}}</th>
                    <td class="num">{{items}}</td>
                    <td class="num">
                        {{#you}}<span class="muted" title="Claims on your own list are hidden from you">Hidden</span>{{/you}}
                        {{^you}}{{#allClaimed}}<span class="ok">All claimed</span>{{/allClaimed}}{{^allClaimed}}{{unclaimed}}{{/allClaimed}}{{/you}}
                    </td>
                    <td class="num">{{valueLabel}}</td>
                    <td class="num">
                        {{#you}}<a href="/lists">Edit</a>{{/you}}
                        {{^you}}<a href="/groups/{{group.id}}/members/{{member.id}}">View list</a>{{/you}}
                    </td>
                </tr>
                {{/stats}}
            </tbody>
        </table>
        </div>
    </section>

    <div class="stack">
        <section class="panel" aria-labelledby="cat-h">
            <h2 class="panel-title" id="cat-h">Most wished-for categories</h2>
            <ul class="bars">
                {{#categories}}
                <li>
                    <span class="bars-label">{{name}}</span>
                    <span class="bars-track"><span class="bars-fill" style="width:{{pct}}%"></span></span>
                    <span class="bars-count">{{count}}</span>
                </li>
                {{/categories}}
            </ul>
        </section>

        <section class="panel" aria-labelledby="wait-h">
            <h2 class="panel-title" id="wait-h">Still has unclaimed gifts</h2>
            <ul class="plain-list">
                {{#waiting}}
                <li>
                    {{#member}}<span class="who"><span class="avatar avatar-sm" style="--c:{{color}}" aria-hidden="true">{{initials}}</span>{{name}}</span>{{/member}}
                    <a href="/groups/{{group.id}}/members/{{member.id}}">{{unclaimed}} open</a>
                </li>
                {{/waiting}}
                {{^waiting}}<li class="muted">Everyone's list is fully claimed.</li>{{/waiting}}
            </ul>
        </section>
    </div>
</div>

<form class="leave" method="post" action="/groups/{{group.id}}/leave">
    <button class="btn btn-danger-quiet btn-small" type="submit">Leave this group</button>
    <span class="muted">Your claims in this group will be released.</span>
</form>
{{> partials/bottom}}
