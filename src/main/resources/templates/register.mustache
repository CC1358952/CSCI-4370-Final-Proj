{{> partials/top}}
<main class="auth">
    <section class="auth-panel">
        <a class="brand" href="/login">
            <svg class="brand-tag" viewBox="0 0 32 20" aria-hidden="true"><path d="M8 0h22a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8L0 10z" fill="currentColor"/><circle cx="8.5" cy="10" r="2.2" fill="var(--paper)"/></svg>
            <span>Sleigh List</span>
        </a>
        <h1>Create your account</h1>
        <p class="lede">Then start a group or join one with an invite code.</p>
        <form class="stack" method="post" action="/register">
            <div class="field-row">
                <div class="field">
                    <label for="firstName">First name</label>
                    <input id="firstName" name="firstName" autocomplete="given-name" required>
                </div>
                <div class="field">
                    <label for="lastName">Last name</label>
                    <input id="lastName" name="lastName" autocomplete="family-name" required>
                </div>
            </div>
            <div class="field">
                <label for="username">Username</label>
                <input id="username" name="username" autocomplete="username" required>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="pw-hint">
                <p class="hint" id="pw-hint">At least 8 characters.</p>
            </div>
            <div class="field">
                <label for="passwordRepeat">Repeat password</label>
                <input id="passwordRepeat" name="passwordRepeat" type="password" autocomplete="new-password" required>
            </div>
            {{#error}}<p class="form-error" role="alert">{{error}}</p>{{/error}}
            <button class="btn btn-block" type="submit">Create account</button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
    </section>
    <aside class="auth-art" aria-hidden="true">
        <div class="art-tag art-tag-1"><span>Secret Santa</span><em>You drew Sam</em></div>
        <div class="art-tag art-tag-2"><span>Budget</span><em>$119 left of $400</em></div>
        <div class="art-tag art-tag-3"><span>Catan</span><em>Must-have</em></div>
        <p class="art-caption">Lists, claims, budgets and the Secret Santa draw, all in one group.</p>
    </aside>
</main>
<script src="/js/app.js"></script>
</body>
</html>
