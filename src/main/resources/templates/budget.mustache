{{> partials/top}}
{{> partials/nav}}
<div class="page-head">
    <div>
        <h1>Holiday budget</h1>
        <p class="lede">Everything you've claimed across your groups, totaled per person.</p>
    </div>
    <form class="budget-set" method="post" action="/budget">
        <label for="amount">Your budget</label>
        <div class="money-input">
            <span aria-hidden="true">$</span>
            <input id="amount" name="amount" type="number" min="0" step="0.01" value="{{budget}}">
        </div>
        <button class="btn btn-quiet btn-small" type="submit">Update</button>
    </form>
</div>

<section class="panel meter-panel" aria-labelledby="meter-h">
    <div class="meter-head">
        <h2 id="meter-h"><span class="meter-spent">{{spentLabel}}</span> <span class="muted">of {{budgetLabel}}</span></h2>
        <p class="{{#over}}warn{{/over}}{{^over}}ok{{/over}}">
            {{#over}}{{remainingLabel}} over budget{{/over}}{{^over}}{{remainingLabel}} left{{/over}}
        </p>
    </div>
    <div class="meter" role="img" aria-label="{{spentLabel}} claimed of a {{budgetLabel}} budget">
        {{#rows}}{{#recipient}}<span class="meter-seg" style="width:{{pctLabel}}%;--c:{{color}}" title="{{name}}: {{totalLabel}}"></span>{{/recipient}}{{/rows}}
    </div>
    <ul class="legend">
        {{#rows}}<li><span class="swatch" style="--c:{{recipient.color}}" aria-hidden="true"></span>{{recipient.firstName}} <span class="muted">{{totalLabel}}</span></li>{{/rows}}
    </ul>
    <p class="small muted">{{giftCount}} gifts for {{recipientCount}} people. {{purchasedLabel}} already bought.</p>
</section>

<div class="recipients">
    {{#rows}}
    <section class="panel recipient" aria-labelledby="r-{{recipient.id}}">
        <header class="recipient-head">
            {{#recipient}}<span class="avatar" style="--c:{{color}}" aria-hidden="true">{{initials}}</span>{{/recipient}}
            <div>
                <h2 id="r-{{recipient.id}}">{{recipient.name}}</h2>
                <p class="muted small">{{groupName}}</p>
            </div>
            <p class="recipient-total">{{totalLabel}}</p>
        </header>
        <ul class="gift-lines">
            {{#gifts}}
            <li>
                <div>
                    <p>{{product.title}}</p>
                    <p class="small {{#purchased}}ok{{/purchased}}{{^purchased}}muted{{/purchased}}">{{#purchased}}Bought{{/purchased}}{{^purchased}}Claimed, not bought yet{{/purchased}}</p>
                </div>
                <span class="gift-price">{{product.priceLabel}}</span>
                <div class="btn-row">
                    {{^purchased}}<form method="post" action="/claims/{{claimId}}/purchased"><button class="btn btn-quiet btn-small" type="submit">Mark bought</button></form>{{/purchased}}
                    <form method="post" action="/claims/{{claimId}}/delete"><button class="btn btn-link btn-small" type="submit">Unclaim</button></form>
                </div>
            </li>
            {{/gifts}}
        </ul>
    </section>
    {{/rows}}
    {{^rows}}
    <div class="empty">
        <h3>Nothing claimed yet</h3>
        <p>Open someone's list from a <a href="/groups">group</a> and press “I'm buying this”.</p>
    </div>
    {{/rows}}
</div>
{{> partials/bottom}}
