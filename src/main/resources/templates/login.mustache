{{> partials/top}}
<main class="auth">
    <section class="auth-panel">
        <a class="brand" href="/login">
            <svg class="brand-tag" viewBox="0 0 32 20" aria-hidden="true"><path d="M8 0h22a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8L0 10z" fill="currentColor"/><circle cx="8.5" cy="10" r="2.2" fill="var(--paper)"/></svg>
            <span>Sleigh List</span>
        </a>
        <h1>Welcome back</h1>
        <p class="lede">Log in to see your groups, lists and who you're shopping for.</p>
        <form class="stack" method="post" action="/login">
            <div class="field">
                <label for="username">Username</label>
                <input id="username" name="username" autocomplete="username" required>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
            </div>
            {{#error}}<p class="form-error" role="alert">{{error}}</p>{{/error}}
            <button class="btn btn-block" type="submit">Log in</button>
        </form>
        <p class="auth-switch">New here? <a href="/register">Create an account</a></p>
    </section>
    <aside class="auth-art" aria-hidden="true">
        <div class="art-tag art-tag-1"><span>Kindle Paperwhite</span><em>Claimed by Leo</em></div>
        <div class="art-tag art-tag-2"><span>Sherpa throw, sage</span><em>You're getting this</em></div>
        <div class="art-tag art-tag-3"><span>Codenames</span><em>Still open</em></div>
        <p class="art-caption">Everyone in the group sees what's been claimed. The person on the list never does.</p>
    </aside>
</main>
<script src="/js/app.js"></script>
</body>
</html>
